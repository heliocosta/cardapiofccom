# Dynamic redirects (Cloudflare Workers Static Assets limit: 100 dynamic rules).
# App-share match URLs (/match/Nov_15_2026_...) are resolved client-side by layouts/404.html
# so _redirects stays well within Cloudflare's 100-rule limit.
/:ed/favorites /:ed/favourites/ 301
/:ed/favorites/ /:ed/favourites/ 301
/:ed/reminder /:ed/my_agenda/ 301
/:ed/reminder/ /:ed/my_agenda/ 301
/league/* /leagues/:splat 301
/:ed/league /:ed/leagues/ 301
/:ed/league/ /:ed/leagues/ 301
/:ed/league/* /:ed/leagues/:splat 301

